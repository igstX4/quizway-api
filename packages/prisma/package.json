{
  "name": "@quizway/prisma",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Prisma schema, client and NestJS module for every QuizWay service.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node --project tsconfig.json src/seed.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.18.0",
    "bcrypt": "^5.1.1",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
