# ---------------------------------------------------------------------------
# QuizWay API — environment template. Copy to `.env`.
#
# The stack runs without any server: SQLite is a file and the queue defaults to
# the in-process driver. Redis is only needed when you enable the worker.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database (SQLite file, no server to run) -------------------------------
# SQLite paths are resolved relative to packages/prisma/prisma/schema.prisma,
# so this points at <repo>/data/quizway.db.
DATABASE_URL="file:../../../data/quizway.db"

# --- Background jobs --------------------------------------------------------
# memory (default): jobs are logged in-process, no Redis required
# redis:            real BullMQ queue consumed by apps/worker
QUEUE_DRIVER=memory
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Service endpoints ------------------------------------------------------
AUTH_SERVICE_GRPC_URL=localhost:50051
QUIZ_SERVICE_GRPC_URL=localhost:50052

# Ports used when running services directly on the host.
GATEWAY_PORT=4000
AUTH_SERVICE_GRPC_PORT=50051
QUIZ_SERVICE_GRPC_PORT=50052

# --- Auth -------------------------------------------------------------------
# Use a long, random value in production: openssl rand -hex 32
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10
